{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "addax/hero-slider",
	"title": "Addax Hero Slider",
	"category": "addax",
	"icon": "slides",
	"description": "Full-screen hero with one or more cross-fading slides. Each slide holds any blocks: headings, text, buttons.",
	"keywords": [ "slider", "hero", "banner", "carousel", "slideshow" ],
	"textdomain": "addax-core",
	"attributes": {
		"autoplay": { "type": "boolean", "default": true },
		"interval": { "type": "number", "default": 6000 },
		"minHeight": { "type": "number", "default": 100 },
		"minHeightUnit": { "type": "string", "default": "vh" },
		"showArrows": { "type": "boolean", "default": true },
		"showDots": { "type": "boolean", "default": true },
		"showProgress": { "type": "boolean", "default": true },
		"showScrollDown": { "type": "boolean", "default": true },
		"scrollTarget": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"align": [ "full", "wide" ],
		"anchor": true,
		"spacing": { "margin": true }
	},
	"providesContext": { "addax/sliderMinHeight": "minHeight", "addax/sliderMinHeightUnit": "minHeightUnit" },
	"example": {},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
