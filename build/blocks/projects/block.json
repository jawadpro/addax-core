{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "addax/projects",
  "title": "Addax Projects",
  "category": "addax",
  "icon": "portfolio",
  "description": "A filterable portfolio grid of your Projects, with hover details and an image lightbox.",
  "keywords": [
    "portfolio",
    "work",
    "gallery",
    "projects",
    "filter"
  ],
  "textdomain": "addax-core",
  "attributes": {
    "count": {
      "type": "number",
      "default": 8
    },
    "columns": {
      "type": "number",
      "default": 4
    },
    "categories": {
      "type": "array",
      "default": [],
      "items": {
        "type": "number"
      }
    },
    "showFilters": {
      "type": "boolean",
      "default": true
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "orderBy": {
      "type": "string",
      "enum": [
        "date",
        "title",
        "menu_order",
        "rand"
      ],
      "default": "date"
    },
    "order": {
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ],
      "default": "desc"
    },
    "aspectRatio": {
      "type": "string",
      "default": "1/1"
    },
    "gap": {
      "type": "number",
      "default": 0
    },
    "allLabel": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}